{
    // ZEsarUX feladatok. Fordítás: Ctrl+Shift+B, a többi: Terminal -> Run Task...
    // A Windows-os fordítás a forrás egy másolatán fut
    // (~/.cache/zesarux-windows-build), az eredmény a ~/zesarux-windows mappába kerül.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/src"
    },
    "tasks": [
        {
            "label": "ZEsarUX: Windows .exe fordítása",
            "detail": "build-windows-cross.sh (mindig a teljes forrást fordítja, kb. 1-2 perc)",
            "type": "shell",
            "command": "./build-windows-cross.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}/src"]
            }
        },
        {
            "label": "ZEsarUX: Windows indítás",
            "detail": "Elindítja a legutóbb lefordított zesarux.exe-t Windowson",
            "type": "shell",
            "command": "cd \"$HOME/zesarux-windows/ZEsarUX_windows-$(git rev-parse --abbrev-ref HEAD)\" && ./zesarux.exe",
            "problemMatcher": []
        },
        {
            "label": "ZEsarUX: Windows fordítás és indítás",
            "detail": "Fordít, majd elindítja",
            "dependsOrder": "sequence",
            "dependsOn": ["ZEsarUX: Windows .exe fordítása", "ZEsarUX: Windows indítás"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "ZEsarUX: kész csomag megnyitása",
            "detail": "Megnyitja a ~/zesarux-windows mappát a Windows Fájlkezelőben",
            "type": "shell",
            "command": "explorer.exe \"$(wslpath -w \"$HOME/zesarux-windows\")\" || true",
            "problemMatcher": []
        },
        {
            "label": "ZEsarUX (Linux): configure",
            "detail": "A WSL-es változat konfigurálása SDL2-vel, debug információval",
            "type": "shell",
            "command": "CFLAGS=\"-g\" ./configure --enable-sdl2",
            "problemMatcher": []
        },
        {
            "label": "ZEsarUX (Linux): fordítás",
            "detail": "make, csak a módosított fájlokat fordítja újra",
            "type": "shell",
            "command": "make -j$(nproc)",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}/src"]
            }
        },
        {
            "label": "ZEsarUX (Linux): indítás",
            "detail": "Fordít, majd elindítja a WSL-es változatot (magyar billentyűzettel)",
            "type": "shell",
            "command": "./zesarux --vo sdl --hungarian-keyboard",
            "dependsOn": "ZEsarUX (Linux): fordítás",
            "problemMatcher": []
        }
    ]
}
